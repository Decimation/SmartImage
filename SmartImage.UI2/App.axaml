<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartImage.UI2.Converters"
             x:Class="SmartImage.UI2.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <StyleInclude Source="avares://AsyncImageLoader.Avalonia/AdvancedImage.axaml" />
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <converters:SearchEngineOptionToIconConverter x:Key="SearchEngineOptionsToIconConverter" />
        <converters:AllocImageValueConverter x:Key="AllocImageConverter" />
    </Application.Resources>
</Application>