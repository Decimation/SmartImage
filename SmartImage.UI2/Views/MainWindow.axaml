<Window
    x:Class="SmartImage.UI2.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SmartImage.UI2.ViewModels"
    xmlns:models="using:SmartImage.UI2.Models"
    xmlns:vm2="using:SmartImage.Lib"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:DataType="vm:MainWindowViewModel"
    Title="SmartImage">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Button Command="{Binding SearchAsync}"></Button>

    <ListBox ItemsSource="{Binding Items}">
        <ListBox.ItemTemplate>
            <DataTemplate DataType="models:ResultItem">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="1"
                               Margin="10,0"
                               Text="{Binding Url}">
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>


</Window>