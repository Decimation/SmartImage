<Window
    x:Class="SmartImage.UI2.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:SmartImage.UI2"
    xmlns:uiVm="using:SmartImage.UI2.ViewModels"
    xmlns:uiModels="using:SmartImage.UI2.Models"
    xmlns:lib="using:SmartImage.Lib"
    xmlns:libModels="using:SmartImage.Lib.Model"
    xmlns:libEngineResults="using:SmartImage.Lib.Engines.Results"
    mc:Ignorable="d"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:uiConverters="clr-namespace:SmartImage.UI2.Converters"
    x:DataType="uiVm:MainWindowViewModel"
    Title="SmartImage">

    <Design.DataContext>
        <uiVm:MainWindowViewModel />
    </Design.DataContext>

    <!-- ReSharper disable XamlBindingWithoutMode -->
    <!-- ReSharper disable InconsistentNaming -->


    <TabControl Background="#0C0C0C">
        <TabItem Header="Search" Foreground="White" FontSize="20">

            <Grid Background="#202020" RowDefinitions="Auto,*,*" ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBox Name="Tb_Input" MinWidth="100" MaxHeight="50" Text="{Binding Input}" />
                    <Button Command="{Binding UploadCommand}" Content="Upload" Foreground="Aqua" />
                    <Button Command="{Binding SearchCommand}" Content="Search" Foreground="LawnGreen" />
                    <Button Command="{Binding ClearCommand}" Content="Clear" />
                    <Button Command="{Binding CancelCommand}" Content="Cancel" Foreground="Red" />

                    <TextBox Name="Tb_Input2" MinWidth="100" MaxHeight="50" MaxWidth="400" Text="{Binding Url, Mode=OneWay}" IsEnabled="False" />

                </StackPanel>

                <Panel Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Width="300" Height="300">
                    <Rectangle Fill="#303030" />
                    <Image Width="300" Height="300" Source="{Binding Image}" />
                    <ProgressBar Value="{Binding Progress}" VerticalAlignment="Bottom" Foreground="LawnGreen" />

                </Panel>

                <ListBox x:Name="Lb_Items" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" MinHeight="300" MinWidth="1000"
                         Background="#1C1C1C" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Single" DoubleTapped="Lb_Items_OnDoubleTapped">

                    <ListBox.KeyBindings>
                        <KeyBinding Command="{Binding LoadItemCommand}" Gesture="Ctrl+L"></KeyBinding>
                        <KeyBinding Command="{Binding HashItemCommand}" Gesture="Ctrl+H"></KeyBinding>
                    </ListBox.KeyBindings>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type libEngineResults:SearchResultItem}">
                            <Border Margin="4" Padding="3" Background="#252525" CornerRadius="4">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">

                                    <!--<asyncImageLoader:AdvancedImage Width="100" Height="100" Margin="0,0,8,0"
                                                                    Source="{Binding Thumbnail, Mode=OneWay}"
                                                                    IsVisible="{Binding $parent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />-->

                                    <Image Height="100" Width="100" Margin="0,0,8,0" IsVisible="{Binding HasThumbnail}"
                                           x:Name="Img_Thumbnail" asyncImageLoader:ImageLoader.Source="{Binding Thumbnail, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal" Spacing="2">

                                        <StackPanel Orientation="Horizontal">

                                            <Image Height="24" Width="24" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Source="{Binding Root.Engine.Option, Converter={StaticResource SearchEngineOptionsToIconConverter}}" />

                                            <TextBlock VerticalAlignment="Center" Padding="8" Foreground="#4FC3F7"
                                                       Text="{Binding Url}" FontSize="16" TextWrapping="Wrap" FontWeight="Bold" />

                                            <TextBlock Foreground="#4FC3F7" Text="{Binding Thumbnail}" FontSize="10" TextWrapping="Wrap"
                                                       IsVisible="{Binding HasThumbnail}" />

                                        </StackPanel>


                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSimilarity}">
                                            <TextBlock Text="Similarity:" Foreground="#808080" />
                                            <TextBlock
                                                Text="{Binding Similarity, StringFormat={}{0}, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                Foreground="#FFD700" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDimensions, Mode=OneWay}">
                                            <TextBlock Text="Size:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Width}" Foreground="#E0E0E0" />
                                            <TextBlock Text="x" Foreground="#E0E0E0" />
                                            <TextBlock Text="{Binding Height}" Foreground="#E0E0E0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Artist:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Artist}" Foreground="#E0E0E0" />

                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Source:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Source}" Foreground="#E0E0E0" />
                                        </StackPanel>

                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>

                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </TabItem>

        <TabItem Header="Config" Foreground="White" FontSize="20">
            <StackPanel>
                <CheckBox IsChecked="{Binding Config.Clipboard}" Content="Clipboard"></CheckBox>
            </StackPanel>
        </TabItem>
    </TabControl>

    <!-- ReSharper restore XamlBindingWithoutMode -->
    <!-- ReSharper restore InconsistentNaming -->

</Window>