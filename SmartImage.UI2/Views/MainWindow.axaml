<Window
    x:Class="SmartImage.UI2.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SmartImage.UI2.ViewModels"
    xmlns:models="using:SmartImage.UI2.Models"
    xmlns:vm2="using:SmartImage.Lib"
    xmlns:vm3="using:SmartImage.Lib.Model"
    xmlns:vm4="using:SmartImage.Lib.Engines"
    xmlns:vm5="using:SmartImage.Lib.Engines.Results"
    mc:Ignorable="d"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:ui2="clr-namespace:SmartImage.UI2"

    x:DataType="vm:MainWindowViewModel"
    Title="SmartImage">

    <!--
d:DesignWidth="1000" d:DesignHeight="675"
    Height="675" Width="1000" MinWidth="1000" MinHeight="325"
-->

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Background="#202020" 
          RowDefinitions="Auto,*,Auto" 
          ColumnDefinitions="Auto,*,Auto">

        <TextBox Name="Tb_Input" Grid.Column="0" Grid.Row="0" MinWidth="100"
                 MaxHeight="50" Text="{Binding Input}">

        </TextBox>

        <Button Command="{Binding SearchCommand}" Content="Search" Grid.Column="1" Grid.Row="0" />

        <Panel Grid.Column="2" Grid.Row="0" Width="300" Height="300">
            <Rectangle Fill="Aquamarine" />
            <Image Width="300" Height="300" Source="{Binding Image, Mode=OneWay}" />
            <ProgressBar Value="{Binding Progress}" VerticalAlignment="Bottom"></ProgressBar>
        </Panel>

        <ListBox ItemsSource="{Binding Items}"
                 SelectionMode="Single" MinWidth="1000" MinHeight="300"
                 Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Grid.RowSpan="2"
                 DoubleTapped="Lb_Items_OnDoubleTapped" x:Name="Lb_Items"
                 SelectedItem="{Binding SelectedItem}">

            <ListBox.KeyBindings>
                <KeyBinding Command="{Binding LoadItemCommand}" Gesture="Ctrl+L"></KeyBinding>
                <KeyBinding Command="{Binding HashItemCommand}" Gesture="Ctrl+H"></KeyBinding>
            </ListBox.KeyBindings>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm5:SearchResultItem}">
                    <Border Margin="4" Padding="6" Background="#252525" CornerRadius="4">

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                            <asyncImageLoader:AdvancedImage Width="100" Height="100"
                                                            Source="{Binding Thumbnail, Mode=OneWay}" Margin="0,0,8,0"
                                                            IsVisible="{Binding Thumbnail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="{Binding Url}" Foreground="#4FC3F7" FontSize="12" FontWeight="Bold"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Similarity:" Foreground="#808080" />
                                    <TextBlock Text="{Binding Similarity, StringFormat={}{0}, UpdateSourceTrigger=PropertyChanged}" Foreground="#FFD700" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding HasDimensions, Mode=OneWay}">
                                    <TextBlock Text="Size:" Foreground="#808080" />
                                    <TextBlock Text="{Binding Width}" Foreground="#E0E0E0" />
                                    <TextBlock Text="x" Foreground="#E0E0E0" />
                                    <TextBlock Text="{Binding Height}" Foreground="#E0E0E0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Artist:" Foreground="#808080" />
                                    <TextBlock Text="{Binding Artist}" Foreground="#E0E0E0"/>

                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Source:" Foreground="#808080" />
                                    <TextBlock Text="{Binding Source}" Foreground="#E0E0E0"/>

                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

    <Window.Resources>
        <ui2:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

</Window>