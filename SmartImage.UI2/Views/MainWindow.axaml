<Window
    x:Class="SmartImage.UI2.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:SmartImage.UI2"
    xmlns:uiVm="using:SmartImage.UI2.ViewModels"
    xmlns:uiModels="using:SmartImage.UI2.Models"
    xmlns:lib="using:SmartImage.Lib"
    xmlns:libModels="using:SmartImage.Lib.Model"
    xmlns:libEngineResults="using:SmartImage.Lib.Engines.Results"
    mc:Ignorable="d"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:uiConverters="clr-namespace:SmartImage.UI2.Converters"
    x:DataType="uiVm:MainWindowViewModel"
    Title="SmartImage">

    <Design.DataContext>
        <uiVm:MainWindowViewModel />
    </Design.DataContext>

    <!-- ReSharper disable XamlBindingWithoutMode -->
    <!-- ReSharper disable InconsistentNaming -->


    <TabControl Background="#0C0C0C">
        <TabItem Header="Search" Foreground="White" FontSize="20">

            <Grid Background="#202020" RowDefinitions="Auto,*,*" ColumnDefinitions="Auto,*,Auto" Margin="10">

                <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <GroupBox Header="Search" Margin="5" Foreground="DeepSkyBlue">

                        <WrapPanel>
                            <Label Content="Query" VerticalContentAlignment="Center" Background="#121212"></Label>
                            <TextBox Name="Tb_Input" MinWidth="100" MaxHeight="50" Text="{Binding Input}" BorderThickness="2" />
                            <Button Command="{Binding UploadCommand}" Content="Upload" Foreground="Aqua" />
                            <Button Command="{Binding SearchCommand}" Content="Search" Foreground="LawnGreen" />
                            <Button Command="{Binding ClearCommand}" Content="Clear" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel" Foreground="Red" />


                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="Upload" Margin="5" Foreground="DeepSkyBlue">

                        <WrapPanel>
                            <Label Content="URL" VerticalContentAlignment="Center" Background="#121212"></Label>

                            <TextBox Name="Tb_QueryUploadUrl" MinWidth="100" MaxHeight="50" MaxWidth="400" Text="{Binding Query.Upload.Url, Mode=OneWay}"
                                     IsEnabled="False" />

                        </WrapPanel>
                    </GroupBox>

                </WrapPanel>

                <Panel Grid.Row="0" Grid.Column="2" Grid.RowSpan="1" Width="300" Height="300">
                    <Rectangle Fill="#303030" />
                    <Image Width="300" Height="300" Source="{Binding Image}" />
                    <ProgressBar Value="{Binding Progress}" VerticalAlignment="Bottom" Foreground="LawnGreen" x:Name="Pb_Busy" />

                </Panel>

                <ListBox x:Name="Lb_Items" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" MinHeight="300" MinWidth="1000"
                         Background="#1C1C1C" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Single" DoubleTapped="Lb_Items_OnDoubleTapped">

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding GalleryDLItemCommand}" Header="gallery-dl" CommandParameter="{Binding SelectedItem }"></MenuItem>
                            <MenuItem Command="{Binding LoadItemCommand}" Header="Scan" CommandParameter="{Binding SelectedItem}"></MenuItem>
                            <MenuItem Command="{Binding HashItemCommand}" Header="Hash" CommandParameter="{Binding SelectedItem}"></MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.DataTemplates>

                        <DataTemplate DataType="{x:Type libEngineResults:SearchResultItem}">
                            <Border Margin="4" Padding="3" Background="#252525" CornerRadius="4">

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                                    <!--<asyncImageLoader:AdvancedImage Width="100" Height="100" Margin="0,0,8,0"
                                                                    Source="{Binding Thumbnail, Mode=OneWay}"
                                                                    IsVisible="{Binding $parent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />-->

                                    <asyncImageLoader:AdvancedImage Source="{Binding Thumbnail, Mode=OneWay}"
                                           Width="100" Height="100" Margin="0,0,8,0" x:Name="Img_Thumbnail" />

                                    <StackPanel Orientation="Vertical" Spacing="2">

                                        <StackPanel Orientation="Horizontal">
                                            <Image Height="24" Width="24"
                                                   Source="{Binding Root.Engine.Option, Converter={StaticResource SearchEngineOptionsToIconConverter}}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding Url}" VerticalAlignment="Center" Foreground="#4FC3F7" FontSize="12"
                                                       TextWrapping="Wrap" FontWeight="Bold" />
                                            <!--
                                            <TextBlock Text="{Binding Thumbnail}" Foreground="#4FC3F7" FontSize="10" TextWrapping="Wrap"
                                                       IsVisible="{Binding HasThumbnail}" />
                                                       -->

                                        </StackPanel>


                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Similarity, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Similarity:" Foreground="#808080" />
                                            <TextBlock
                                                Text="{Binding Similarity, StringFormat={}{0}, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                Foreground="#FFD700" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Width, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Size:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Width}" Foreground="#E0E0E0" />
                                            <TextBlock Text="x" Foreground="#E0E0E0" />
                                            <TextBlock Text="{Binding Height}" Foreground="#E0E0E0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Artist:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Artist}" Foreground="#E0E0E0" />

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Source:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Source}" Foreground="#E0E0E0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Title:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" TextWrapping="Wrap" />
                                        </StackPanel>

                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type libEngineResults:ScannedResultItem}">
                            <Border Margin="24,2,4,2" Padding="3" Background="#1E2620" CornerRadius="4" BorderBrush="#3A3A3A"
                                    BorderThickness="1,0,0,0">

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                                    <Image Width="80" Height="80" Margin="0,0,8,0" x:Name="Img_Scanned"
                                           Source="{Binding AllocImage, Converter={StaticResource AllocImageConverter}}" />
                                    <!--
                                    <asyncImageLoader:AdvancedImage Width="80" Height="80" Margin="0,0,8,0" x:Name="Img_Scanned"
                                                                               Source="{Binding Url}" />-->

                                    <StackPanel Orientation="Vertical" Spacing="2">

                                        <StackPanel Orientation="Horizontal">
                                            <Image Height="20" Width="20"
                                                   Source="{Binding Root.Engine.Option, Converter={StaticResource SearchEngineOptionsToIconConverter}}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" />

                                            <TextBlock Text="{Binding Url}" VerticalAlignment="Center" Foreground="#81C784" FontSize="12"
                                                       TextWrapping="Wrap" FontWeight="Bold" />

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Similarity, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Similarity:" Foreground="#808080" />
                                            <TextBlock
                                                Text="{Binding Similarity, StringFormat={}{0}, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                Foreground="#FFD700" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Width, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Size:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Width}" Foreground="#E0E0E0" />
                                            <TextBlock Text="x" Foreground="#E0E0E0" />
                                            <TextBlock Text="{Binding Height}" Foreground="#E0E0E0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Artist:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Artist}" Foreground="#E0E0E0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Source:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Source}" Foreground="#E0E0E0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Title:" Foreground="#808080" />
                                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" TextWrapping="Wrap" />
                                        </StackPanel>

                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>

                    </ListBox.DataTemplates>
                </ListBox>

            </Grid>
        </TabItem>

        <TabItem Header="Config" Foreground="White" FontSize="20">
            <Grid Background="#202020" ColumnDefinitions="*,*,*" Margin="10">

                <GroupBox Grid.Row="0" Grid.Column="0" Header="Engines" Margin="5">


                    <StackPanel Spacing="10">
                        <StackPanel>
                            <Label Content="Upload Engine" Foreground="White" />
                            <ComboBox ItemsSource="{Binding UploadEngineOptions}" SelectedItem="{Binding Config.UploadEngine, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel>
                            <Label Content="Search Engines" Foreground="White" />
                            <ScrollViewer Height="300" Background="#121212">
                                <ItemsControl ItemsSource="{Binding SearchEngineItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                                                      Foreground="White" Margin="4,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel>
                            <Label Content="Priority Engines" Foreground="White" />
                            <ScrollViewer Height="300" Background="#121212">
                                <ItemsControl ItemsSource="{Binding PriorityEngineItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                                                      Foreground="White" Margin="4,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Options" Grid.Column="1" Margin="5" Foreground="White">
                    <StackPanel Spacing="8">
                        <CheckBox IsChecked="{Binding Config.Clipboard}" Content="Clipboard" Foreground="White" />
                        <CheckBox IsChecked="{Binding Config.AutoSearch}" Content="Auto-search" Foreground="White" />
                        <CheckBox IsChecked="{Binding Config.OpenRaw}" Content="Open raw" Foreground="White" />
                        <CheckBox IsChecked="{Binding Config.OnTop}" Content="Keep window on top" Foreground="White" />
                        <CheckBox IsChecked="{Binding Config.ReadCookies}" Content="Read cookies" Foreground="White" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Advanced" Grid.Column="2" Margin="5" Foreground="White">
                    <StackPanel Spacing="8">
                        <CheckBox IsChecked="{Binding Config.FlareSolverr}" Content="FlareSolverr" Foreground="White" />

                        <StackPanel>
                            <Label Content="FlareSolverr API URL" Foreground="White" />
                            <TextBox Text="{Binding Config.FlareSolverrApiUrl}" IsEnabled="{Binding Config.FlareSolverr}" />
                        </StackPanel>

                        <StackPanel>
                            <Label Content="SauceNAO API Key" Foreground="White" />
                            <TextBox Text="{Binding Config.SauceNaoKey}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </Grid>
        </TabItem>
    </TabControl>

    <!-- ReSharper restore XamlBindingWithoutMode -->
    <!-- ReSharper restore InconsistentNaming -->

</Window>